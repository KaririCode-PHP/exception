{
    "name": "kariricode/exception",
    "description": "Optional base classes for the exception families of kariricode/contract: one abstract base per family, error codes as int-backed enums inside registered blocks, and messages that are safe to log.",
    "keywords": [
        "kariricode",
        "exception",
        "error-codes",
        "contract",
        "arfa",
        "php84"
    ],
    "homepage": "https://kariricode.org/",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Walmir Silva",
            "email": "walmir.silva@kariricode.org"
        }
    ],
    "require": {
        "php": "^8.4",
        "kariricode/contract": "^2.11"
    },
    "autoload": {
        "psr-4": {
            "KaririCode\\Exception\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KaririCode\\Exception\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/KaririCode-PHP/exception/issues",
        "source": "https://github.com/KaririCode-PHP/exception"
    },
    "extra": {
        "arfa": {
            "version": "1.3",
            "level": 1
        },
        "asvs": {
            "version": "5.0",
            "level": 1
        },
        "branch-alias": {
            "dev-main": "2.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "kcode test",
        "test-unit": "kcode test --testsuite=unit",
        "test-conformance": "kcode test --testsuite=conformance",
        "phpstan": "kcode run phpstan analyse --no-progress --memory-limit=1G",
        "psalm": "kcode run psalm --no-cache",
        "complexity": "@php tools/complexity.php src",
        "mutation": "kcode run infection --threads=max --no-progress --show-mutations",
        "security": [
            "@composer audit --locked",
            "@composer audit --locked --working-dir=.kcode",
            "@php tools/secret-scan.php"
        ],
        "sbom": "@php tools/sbom.php sbom.cdx.json",
        "cs-check": "kcode cs:fix --check",
        "cs-fix": "kcode cs:fix",
        "check": [
            "@cs-check",
            "@phpstan",
            "@psalm",
            "@complexity",
            "@test",
            "@mutation"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
